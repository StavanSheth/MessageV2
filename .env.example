# Application Settings
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./data/database/app.db
SYNC_DATABASE_URL=sqlite:///./data/database/app.db

# Browser Automation
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=100
BROWSER_TIMEOUT=30000
TASK_TIMEOUT=60000

# Automation Settings
MESSAGE_MODE=automatic
WORKER_MODE=single
MAX_WORKERS=1
RETRY_LIMIT=3
VERIFICATION_THRESHOLD=0.75
DEFAULT_MESSAGE=Hey

# Observability & Vision
SCREENSHOT_ENABLED=true
OCR_ENABLED=true
LOG_LEVEL=INFO

# Server
HOST=127.0.0.1
PORT=8000
DASHBOARD_PORT=5173
